# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase.
# Los encuentras en supabase.com → tu proyecto → Project Settings → API.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_publica

# Con Supabase local (requiere Docker), `npx supabase start` imprime ambos valores.
# Para probar desde celulares usa la IP de tu PC (ej. http://192.168.1.50:54321), no 127.0.0.1.
